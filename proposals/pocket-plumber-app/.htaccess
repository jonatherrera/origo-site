# Basic Auth via mod_rewrite (self-contained — no .htpasswd file required)
# Credentials: pocketp / DCn39#me*0RjS3
# Base64 of "pocketp:DCn39#me*0RjS3" = cG9ja2V0cDpEQ24zOSNtZSowUmpTMw==

RewriteEngine On

# If the Authorization header doesn't match the expected Basic credentials, return 401
RewriteCond %{HTTP:Authorization} !^Basic\ cG9ja2V0cDpEQ24zOSNtZSowUmpTMw==$
RewriteRule .* - [R=401,L]

# Send the WWW-Authenticate header on 401 so browsers show the password prompt
<IfModule mod_headers.c>
  Header always set WWW-Authenticate 'Basic realm="Pocket Plumber Proposal"' "expr=%{REQUEST_STATUS} == 401"
</IfModule>

ErrorDocument 401 "Authentication required to view this proposal."
