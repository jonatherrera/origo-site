# Basic Auth via mod_rewrite (self-contained — no .htpasswd file required)
# Credentials: tatum / WPwPuCPRjZFh4%
# Base64 of "tatum:WPwPuCPRjZFh4%" = dGF0dW06V1B3UHVDUFJqWkZoNCU=

RewriteEngine On

# If the Authorization header doesn't match the expected Basic credentials, return 401
RewriteCond %{HTTP:Authorization} !^Basic\ dGF0dW06V1B3UHVDUFJqWkZoNCU=$
RewriteRule .* - [R=401,L]

# Send the WWW-Authenticate header on 401 so browsers show the password prompt
<IfModule mod_headers.c>
  Header always set WWW-Authenticate 'Basic realm="Tatum Law Proposal"' "expr=%{REQUEST_STATUS} == 401"
</IfModule>

ErrorDocument 401 "Authentication required to view this proposal."
