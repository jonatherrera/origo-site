# Basic Auth via mod_rewrite (self-contained, no .htpasswd file required)
# Credentials: kelly / 2^9sv84J04VHyP
# Base64 of "kelly:2^9sv84J04VHyP" = a2VsbHk6Ml45c3Y4NEowNFZIeVA=

RewriteEngine On

# If the Authorization header doesn't match the expected Basic credentials, return 401
RewriteCond %{HTTP:Authorization} !^Basic\ a2VsbHk6Ml45c3Y4NEowNFZIeVA=$
RewriteRule .* - [R=401,L]

# Send the WWW-Authenticate header on 401 so browsers show the password prompt
<IfModule mod_headers.c>
  Header always set WWW-Authenticate 'Basic realm="360 Collision Growth Plan"' "expr=%{REQUEST_STATUS} == 401"
</IfModule>

ErrorDocument 401 "Authentication required to view this proposal."
